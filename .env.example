# =============================================================================
# Vivah Sutra — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Django Core -----------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=False
DJANGO_ENV=prod              # "prod" → PostgreSQL, any other value → SQLite
ALLOWED_HOSTS=*               # Comma-separated or "*" for any

# --- PostgreSQL ------------------------------------------------------------
# Option A: Connection URL (preferred — Railway sets this automatically)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Option B: Individual variables (used when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=VivahSutra
DB_USER=VivahSutra
DB_PASSWORD=VivahSutra
# Railway also sets these as alternatives (fallback if DB_* vars are unset):
# PGHOST=localhost  PGPORT=5432  PGDATABASE=VivahSutra  PGUSER=VivahSutra  PGPASSWORD=VivahSutra

# --- Redis / Channels (optional — omitting falls back to in-memory) --------
REDIS_URL=redis://localhost:6379/0

# --- App Server ------------------------------------------------------------
PORT=8000

# --- Email — Gmail SMTP (set EMAIL_HOST_PASSWORD to your Gmail app password) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=VivahSutramatrimony@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=${EMAIL_HOST_USER}

# --- Alternative Email Providers (commented out in code) -------------------
# BREVO_API_KEY=
# RESEND_API_KEY=

# --- Supabase (image/file storage) -----------------------------------------
# These are hardcoded fallbacks in settings.py; override via env if needed.
# DEFAULT_FEMALE_FALLBACK_URL=<supabase-url>
# DEFAULT_MALE_FALLBACK_URL=<supabase-url>

# --- CSRF / Security -------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://example.com
# CSRF_COOKIE_SECURE=False
# SESSION_COOKIE_SECURE=False
